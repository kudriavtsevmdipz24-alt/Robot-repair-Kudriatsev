<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="HealthBarBackground" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/UIHealthFrame.png?fileID=21300000&amp;guid=b47cdbd2062c5e64ba5a0bf3f6b045b1&amp;type=3#UIHealthFrame&quot;); -unity-background-scale-mode: scale-to-fit; width: 346px; height: 165px; position: absolute; top: 30px; left: 30px;">
        <ui:VisualElement name="HealthBarContainer" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); position: absolute; top: 52px; left: 144px; width: 189px; height: 52px;">
            <ui:VisualElement name="HealthBar" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/UIHealthBar.png?fileID=21300000&amp;guid=39fe000f2b6d9d04b93d6a76310e29aa&amp;type=3#UIHealthBar&quot;); -unity-background-scale-mode: stretch-to-fill; width: 100%; height: 100%;" />
        </ui:VisualElement>
        <ui:VisualElement name="CharacterPortrait" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/CharacterPortrait.png?fileID=21300000&amp;guid=0332b35b8fe3cf8458eb0558889493d1&amp;type=3#CharacterPortrait&quot;); -unity-background-scale-mode: scale-to-fit; position: absolute; top: 12px; left: 6px; width: 129px; height: 135px;" />
    </ui:VisualElement>
    <ui:Label name="FixedCounter" text="Полагоджено 0 / 0" picking-mode="Ignore" style="position: absolute; top: 40px; right: 40px; font-size: 34px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: upper-right;" />
    <ui:VisualElement name="NPCDialogueContainer" picking-mode="Ignore" style="position: absolute; left: 10%; right: 10%; bottom: 18px; height: 190px; display: none;">
        <ui:VisualElement name="NPCDialogueBackground" style="width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/UIDialogueBox.png?fileID=21300000&amp;guid=924827a9385ec3544b572966c8853b0a&amp;type=3#UIDialogueBox&quot;); -unity-background-scale-mode: scale-to-fit;">
            <ui:Label name="NPCDialogueText" tabindex="-1" text="Лагодь зламані роботи: стріляй шестернями (C) у кожного ворога! Стережися води і зламаних машин — вони забирають здоров'я. Повертайся, коли всі роботи будуть справні!" display-tooltip-when-elided="false" style="width: 100%; height: 100%; padding-left: 44px; padding-right: 44px; padding-top: 28px; padding-bottom: 28px; font-size: 18px; line-height: 22px; white-space: normal; overflow: hidden; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-text-align: upper-left;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Template name="EndScreen" src="project://database/Assets/_2DAdventureGame/UI/EndScreen.uxml?fileID=9197481963319205126&amp;guid=f429a8b84b1a41f59e50eada6566483b&amp;type=3#EndScreen" />
