    <ui:Label name="FixedCounter" text="Полагоджено 0 / 0" picking-mode="Ignore" style="position: absolute; top: 24px; right: 24px; padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; background-color: rgba(0, 0, 0, 0.55); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 38px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: upper-right;" />
