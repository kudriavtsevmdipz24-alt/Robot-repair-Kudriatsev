<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/UIDialogueBox.png?fileID=21300000&amp;guid=924827a9385ec3544b572966c8853b0a&amp;type=3#UIDialogueBox&quot;); -unity-background-scale-mode: scale-to-fit; width: 100%; height: 100%; overflow: hidden;">
        <ui:Label name="NPCDialogueText" tabindex="-1" text="Лагодь зламані роботи: стріляй шестернями (C) у кожного ворога! Стережися води і зламаних машин — вони забирають здоров'я. Повертайся, коли всі роботи будуть справні!" display-tooltip-when-elided="true" style="flex-grow: 1; padding-left: 46px; padding-right: 46px; padding-top: 30px; padding-bottom: 30px; font-size: 20px; line-height: 24px; white-space: normal; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-text-align: upper-left;" />
