    <ui:VisualElement name="Background" style="width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/UIDialogueBox.png?fileID=21300000&amp;guid=924827a9385ec3544b572966c8853b0a&amp;type=3#UIDialogueBox&quot;); -unity-background-scale-mode: stretch-to-fill; overflow: hidden;">
        <ui:Label name="NPCDialogueText" tabindex="-1" text="Лагодь зламані роботи: стріляй шестернями (C) у кожного ворога! Стережися води і зламаних машин — вони забирають здоров'я. Повертайся, коли всі роботи будуть справні!" display-tooltip-when-elided="false" style="position: absolute; left: 12%; right: 12%; top: 20%; bottom: 16%; font-size: 17px; line-height: 21px; white-space: normal; overflow: hidden; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-text-align: upper-left;" />
