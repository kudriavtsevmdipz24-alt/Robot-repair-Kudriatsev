<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/Background.png?fileID=2800000&amp;guid=45466ef8ed5f0fa4a94d9de87febf418&amp;type=3#Background&quot;); -unity-background-scale-mode: stretch-to-fill;">
        <ui:VisualElement name="StartCard" style="width: 820px; min-height: 420px; background-color: rgba(0, 0, 0, 0.62); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; padding-left: 48px; padding-right: 48px; padding-top: 40px; padding-bottom: 40px; justify-content: space-between;">
            <ui:Label name="GameTitle" text="Robot Repair: Timed Gate" style="font-size: 56px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: upper-center; margin-bottom: 16px;" />
            <ui:Label name="GameGoal" text="Полагодь усіх роботів і встигни проскочити крізь двері, поки вони відчинені." style="font-size: 28px; color: rgb(235, 240, 255); -unity-text-align: upper-center; white-space: normal; margin-bottom: 30px;" />
            <ui:Label text="WASD / стрілки — рух    C / Пробіл — постріл    X — діалог" style="font-size: 20px; color: rgb(235, 240, 255); -unity-text-align: middle-center; white-space: normal; margin-bottom: 24px;" />
            <ui:Button text="Почати гру" name="StartButton" style="height: 72px; margin-left: 140px; margin-right: 140px; font-size: 32px; -unity-font-style: bold; background-color: rgb(255, 210, 80); color: rgb(20, 20, 20); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
